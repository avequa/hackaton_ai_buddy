# Скопируйте в .env и впишите ключ: cp .env.example .env

# OpenRouter, бесплатные модели, 50 запросов в день на аккаунт
# Ключ: https://openrouter.ai/settings/keys (карта не нужна)
OPENROUTER_API_KEY=

# Необязательно: секрет подписи JWT (по умолчанию dev-значение из compose.yaml), токен демо-ручек, задержка согласования
# JWT_SECRET=
# DEMO_TOKEN=demo
# APPROVAL_DELAY=15s
# POSTGRES_PASSWORD=   # пароль базы внутри compose, наружу база не публикуется
# RADAR_TOKEN=         # токен ядра к incident-radar внутри compose
