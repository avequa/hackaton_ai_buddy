# Скопируй в .env и впиши ключ: cp .env.example .env

# Вариант 1 (по умолчанию): OpenRouter, бесплатные модели, 50 запросов в день на аккаунт.
# Ключ: https://openrouter.ai/settings/keys (карта не нужна)
OPENROUTER_API_KEY=

# Вариант 2: DeepSeek, платный (нужно пополнить баланс).
# Ключ: https://platform.deepseek.com -> API Keys. Раскомментируй обе строки.
# LLM_CONFIG=llm-gateway.deepseek.yaml
# DEEPSEEK_API_KEY=

# Необязательно: секрет подписи JWT (по умолчанию dev-значение из compose.yaml), токен демо-ручек, задержка согласования
# JWT_SECRET=
# DEMO_TOKEN=demo
# APPROVAL_DELAY=15s
