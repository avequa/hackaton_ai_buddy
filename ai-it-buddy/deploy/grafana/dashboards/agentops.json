{
  "uid": "ai-it-buddy-agentops",
  "title": "AI IT-Buddy - AgentOps",
  "tags": [
    "ai-it-buddy"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
