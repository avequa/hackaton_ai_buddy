{
  "uid": "ai-it-buddy-agentops",
  "title": "AI IT-Buddy - AgentOps",
  "tags": [
    "ai-it-buddy"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Польза для стажера и наставника",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Вопросов без наставника",
      "description": "Deflection rate: доля ходов диалога, после которых не понадобились тикет в поддержку, эскалация наставнику или ответ «в базе знаний нет». Приближение: считается по событиям, а не по диалогам.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(1 - (((sum(increase(buddy_tool_calls_total{tool=\"draft_ticket\",outcome=\"draft_created\"}[$__range]))) or vector(0)) + ((sum(increase(buddy_tool_calls_total{outcome=\"not_found_in_kb\"}[$__range]))) or vector(0)) + ((sum(increase(buddy_request_transitions_total{status=\"pending_mentor\"}[$__range]))) or vector(0))) / sum(increase(buddy_chat_turns_total{outcome=\"ok\"}[$__range])), 0)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ходов диалога",
      "description": "Сообщения стажеров помощнику за выбранный период.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
